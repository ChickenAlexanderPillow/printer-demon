<Window x:Class="PrinterDemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrinterDemon"
        Title="Printer Demon"
        Width="380"
        Height="400"
        MinWidth="380"
        MinHeight="400"
        MaxWidth="380"
        MaxHeight="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Bahnschrift"
        AllowsTransparency="True"
        Icon="/PrinterDemon;component/assets/PrinterDemon.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Border x:Name="WindowFrame"
            CornerRadius="24"
            Background="{StaticResource WindowBackgroundBrush}">
        <Grid x:Name="RootSurface"
              Background="Transparent"
              AllowDrop="True"
              PreviewDragEnter="Window_DragEnter"
              PreviewDragOver="Window_DragOver"
              PreviewDragLeave="Window_DragLeave"
              PreviewDrop="Window_Drop"
              MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border x:Name="DropSurface"
                Margin="12"
                Padding="26"
                CornerRadius="18"
                BorderThickness="0"
                Background="{StaticResource TileSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <local:DemonCharacter x:Name="DemonVisual" HorizontalAlignment="Center"
                                          VerticalAlignment="Top" Margin="0,0,0,0" />
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,18">
                    <TextBlock x:Name="TitleText" Text="Drop Files" FontSize="34" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusBrush}" TextAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Drop PDFs or images to print."
                               FontSize="14" Foreground="{StaticResource HintBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="284"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                        CornerRadius="11" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                    <TextBlock x:Name="DetailText" FontSize="11" Foreground="{StaticResource HintBrush}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                    <Grid Margin="0,8,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QueueSummaryText" Text="QUEUE · 0 REMAINING · 0 COMPLETE"
                                   FontSize="9" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AccentBrush}" Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="OPEN QUEUE" Click="QueuePopOut_Click"
                                Width="78" Padding="2" FontSize="8" Foreground="{StaticResource AccentBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                    </Grid>
                    <ListBox x:Name="QueueList"
                             HorizontalAlignment="Stretch"
                             MinHeight="0"
                             MaxHeight="96"
                             ItemsSource="{Binding SessionQueue}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource HintBrush}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Width="38" Height="4" Margin="6,3,6,0"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 IsIndeterminate="{Binding IsActive}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="1" Text="✓" FontSize="14" FontWeight="Bold"
                                               Foreground="#55D98B" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="4,0,0,0"
                                               FontSize="10" Foreground="{StaticResource StatusBrush}"
                                               TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="3"
                           x:Name="VersionText"
                           Text="v—"
                           FontSize="8"
                           Foreground="{StaticResource HintBrush}"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" />
                </Grid>
        </Border>
        <Border x:Name="HotEdgeGlow"
                Margin="4"
                CornerRadius="21"
                BorderThickness="3"
                BorderBrush="#FFFF2100"
                Background="Transparent"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="5">
            <Border.Effect>
                <DropShadowEffect Color="#FFFF2100"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.95" />
            </Border.Effect>
        </Border>
        <Button x:Name="CloseButton"
                Content="×"
                Click="CloseButton_Click"
                MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"
                ToolTip="Close"
                Width="30"
                Height="30"
                Margin="0,18,18,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{StaticResource HintBrush}"
                FontFamily="Segoe UI Symbol"
                FontSize="22"
                Cursor="Hand" />
        </Grid>
    </Border>
</Window>
