<Window x:Class="PrinterDemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Demon"
        Width="360"
        Height="360"
        MinWidth="360"
        MinHeight="360"
        MaxWidth="360"
        MaxHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Bahnschrift"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootSurface"
          Background="Transparent"
          AllowDrop="True"
          PreviewDragEnter="Window_DragEnter"
          PreviewDragOver="Window_DragOver"
          PreviewDragLeave="Window_DragLeave"
          PreviewDrop="Window_Drop"
          MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border x:Name="DropSurface"
                Margin="12"
                Padding="28"
                CornerRadius="28"
                BorderThickness="1.5"
                BorderBrush="{StaticResource TileBorderBrush}"
                Background="{StaticResource TileSurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#087D9D" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="PRINTER DEMON" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Drop Files" FontSize="34" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusBrush}" TextAlignment="Center" />
                    <Border Width="96" Height="2" Margin="0,12,0,16" CornerRadius="1"
                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Drop PDFs or images to print."
                               FontSize="14" Foreground="{StaticResource HintBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="252"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource HintBrush}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="QueueSummaryText" Text="SESSION QUEUE - 0 remaining - 0 complete"
                                   FontSize="10" Foreground="{StaticResource AccentBrush}" Opacity="0.8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="POP OUT" Click="QueuePopOut_Click"
                                Padding="5,2" FontSize="9" Foreground="{StaticResource AccentBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                    </Grid>
                    <ListBox x:Name="QueueList"
                             Width="250"
                             Height="64"
                             ItemsSource="{Binding SessionQueue}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource HintBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Width="38" Height="4" Margin="6,3,6,0"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 IsIndeterminate="{Binding IsActive}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="1" Text="✓" FontSize="14" FontWeight="Bold"
                                               Foreground="#55D98B" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="4,0,0,0"
                                               FontSize="10" Foreground="{StaticResource StatusBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
