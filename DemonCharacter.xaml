<UserControl x:Class="PrinterDemon.DemonCharacter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="88" Height="88"
             ClipToBounds="False">
    <Grid x:Name="CharacterImageHost"
          Width="88" Height="88"
          ClipToBounds="False"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.75">
        <Image x:Name="IdleDemonImage"
               Source="print demon smile.png"
               Stretch="Uniform"
               Width="80" Height="80"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Image x:Name="DancingDemonImage"
               Source="print demon.png"
               Stretch="Uniform"
               Width="80" Height="80"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Collapsed" />
    </Grid>
</UserControl>
