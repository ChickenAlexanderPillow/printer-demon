<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>assets\PrinterDemon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Include="assets\GhostscriptBundle.zip" LogicalName="PrinterDemon.GhostscriptBundle.zip" />
    <Resource Include="print demon.png" />
    <Resource Include="print demon smile.png" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="assets\PrinterDemon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('tools\ghostscript\installed')">
    <Content Include="tools\ghostscript\installed\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="CopyWorkspaceGhostscript" AfterTargets="Publish" Condition="!Exists('$(PublishDir)tools\ghostscript\installed\bin\gswin64c.exe') AND Exists('..\resize-ads\ResizeAdsApp\tools\ghostscript\installed\bin\gswin64c.exe')">
    <ItemGroup>
      <GhostscriptFiles Include="..\resize-ads\ResizeAdsApp\tools\ghostscript\installed\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(GhostscriptFiles)" DestinationFiles="@(GhostscriptFiles->'$(PublishDir)tools\ghostscript\installed\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
