<Window x:Class="PrinterDemon.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Demon Queue"
        Width="620"
        Height="560"
        MinWidth="460"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#111215"
        FontFamily="Bahnschrift">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="PRINTER DEMON" FontSize="12"
                   Foreground="{StaticResource AccentBrush}" />
        <TextBlock Grid.Row="1" Text="SESSION QUEUE" Margin="0,4,0,12"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource StatusBrush}" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding SessionQueue}"
                 Background="#191A1E"
                 BorderBrush="#34424A"
                 BorderThickness="1"
                 Padding="10"
                 Foreground="{StaticResource HintBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                       Foreground="#7F8790" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Width="78" Height="6"
                                     Margin="8,0" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsActive}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1" Text="✓" FontSize="19" FontWeight="Bold"
                                   Foreground="#55D98B" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="8,0,0,0"
                                   FontSize="11" Foreground="{StaticResource StatusBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
