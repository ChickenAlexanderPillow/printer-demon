<Window x:Class="PrinterDemon.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Demon Queue"
        Width="620"
        Height="560"
        MinWidth="460"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        FontFamily="Bahnschrift"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="20" CornerRadius="20"
            Background="{StaticResource TileSurfaceBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#55000000" BlurRadius="20" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
    <Grid Margin="18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="PRINTER DEMON · PRINT STATION" FontSize="12"
                   Foreground="{StaticResource AccentBrush}" />
        <Button Grid.Row="0" Content="×" Click="CloseButton_Click"
                Width="28" Height="28" Margin="0,-10,-10,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Padding="0" FontSize="21" FontFamily="Segoe UI Symbol"
                Foreground="{StaticResource HintBrush}" Background="Transparent"
                BorderThickness="0" Cursor="Hand" />
        <TextBlock Grid.Row="1" Text="SESSION QUEUE" Margin="0,4,0,12"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource StatusBrush}" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding SessionQueue}"
                 Background="{StaticResource TileSurfaceBrush}"
                 BorderBrush="{StaticResource PanelBorderBrush}"
                 BorderThickness="2"
                 Padding="10"
                 Foreground="{StaticResource HintBrush}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                       Foreground="#7F8790" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Width="78" Height="6"
                                     Margin="8,0" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsActive}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1" Text="✓" FontSize="19" FontWeight="Bold"
                                   Foreground="#55D98B" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="8,0,0,0"
                                   FontSize="11" Foreground="{StaticResource StatusBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
    </Border>
</Window>
