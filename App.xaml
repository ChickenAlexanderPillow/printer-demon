<Application x:Class="PrinterDemon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#141416" Offset="0" />
            <GradientStop Color="#0E0E10" Offset="0.55" />
            <GradientStop Color="#101820" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TileSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#191A1E" Offset="0" />
            <GradientStop Color="#111215" Offset="0.6" />
            <GradientStop Color="#101A20" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TileBorderBrush" Color="#214456" />
        <SolidColorBrush x:Key="StatusBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="HintBrush" Color="#A3A6AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#42B7D6" />
    </Application.Resources>
</Application>
